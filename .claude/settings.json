{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push -d*)",
      "Bash(git -C * push * -d*)",
      "Bash(git -C * push * --delete*)",
      "Bash(git -C * push * :*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable set*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X PATCH*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method*)",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__create_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__update_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__copy_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__trash_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__share_file",
      "Bash(gh run cancel *)",
      "Bash(*actions/runs/*/cancel*)",
      "Bash(*actions/runs/*/force-cancel*)",
      "Bash(gh workflow disable *)",
      "Bash(*actions/workflows/*/disable*)",
      "Bash(*actions/secrets*)",
      "Bash(*actions/permissions*)",
      "Bash(*actions/variables*-X*)",
      "Bash(*-X*actions/variables*)",
      "Bash(*branches/*/protection*)",
      "Bash(*/rulesets*)",
      "Bash(*git/refs*-X*)",
      "Bash(*-X*git/refs*)",
      "Bash(gh api * -X P*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method P*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api graphql*mutation*)",
      "Bash(git push *--no-verify*)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -C * -c core.hooksPath*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(git -C * config *core.hooksPath*)",
      "mcp__*__create_file",
      "mcp__*__update_file",
      "mcp__*__copy_file",
      "mcp__*__trash_file",
      "mcp__*__share_file",
      "mcp__d0aed261-9b05-4aa6-b869-8e7650c5aab8__create_file",
      "mcp__d0aed261-9b05-4aa6-b869-8e7650c5aab8__update_file",
      "mcp__d0aed261-9b05-4aa6-b869-8e7650c5aab8__copy_file",
      "mcp__d0aed261-9b05-4aa6-b869-8e7650c5aab8__trash_file",
      "mcp__d0aed261-9b05-4aa6-b869-8e7650c5aab8__share_file"
    ],
    "allow": [
      "Bash(gh pr edit * --add-label \"review: approved\")",
      "Bash(gh pr edit * --remove-label \"review: approved\")",
      "Bash(gh workflow run walks.yml *)",
      "Bash(bash ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/gh.sh api -X POST repos/expat-ready/xpatready/actions/workflows/walks.yml/dispatches *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/session-start.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Loading Pathway Configurator state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh pr close*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh pr review*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "(^|__)(start_session|create_session)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/lane-preflight.sh --hook",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/agent-model-guard.sh --hook",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/lead-check-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/stop-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/ai-workers/tools/prompt-log.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/Xpatready/code/**",
    "**/Xpatready/sources/**",
    "**/Xpatready/archive/**"
  ]
}