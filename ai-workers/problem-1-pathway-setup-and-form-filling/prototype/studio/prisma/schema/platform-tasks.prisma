// platform-tasks.prisma — the firm's tasks (PF-29a, R1.75). Owner: the screens lane for R1.75 (the platform's task area).
// One file per area (DB-SPLIT, studio/DEVELOPING.md): a new module adds its own file here; never edit another area's file without its owner.
// Migration 20261125100000_pf29a_plat_task (additive: one new table). Rules Prisma cannot say (checks, the update rule,
// PF-12's wall) are in the migration. Written only by api/src/platform/tasks/ (the task service).

/// One task (AG-13-1, -2, -5, -8, -62; BR-19). It sits on a host a module registers (api/src/platform/tasks/hosts.ts):
/// host_type `fo_person`, `case`, `case_client` or `firm` (host_id null only for `firm`), with the context it was made in
/// (LEAD, PROSPECT or CASE, and its id). assignee null = Unassigned; never another firm's person (trigger); never a
/// deactivated or suspended person (the service). The assignee is checked against platform_staff of the same firm by a
/// trigger, not a foreign key (as fo_lead's owner: Prisma cannot say an optional composite key), so platform.prisma gets
/// one back-relation line only. due_at and due_zone come together (the record's office zone, IANA).
/// CANCELLED needs a reason; COMPLETED needs who and when. version: the change counter a change names (409 when stale).
/// source_key: an automation's task is made once per firm. created_by, assigned_by, completed_by: actor words
/// (`staff:<id>`, `system:<door>`), as the audit lines carry.
model PlatTask {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId          String    @map("firm_id") @db.Uuid
  hostType        String    @map("host_type")
  hostId          String?   @map("host_id") @db.Uuid
  contextType     String?   @map("context_type")
  contextId       String?   @map("context_id") @db.Uuid
  title           String
  description     String?
  category        String?
  assigneeStaffId String?   @map("assignee_staff_id") @db.Uuid
  assignedBy      String?   @map("assigned_by")
  dueAt           DateTime? @map("due_at") @db.Timestamptz
  dueZone         String?   @map("due_zone")
  priority        String    @default("MEDIUM")
  status          String    @default("OPEN")
  cancelReason    String?   @map("cancel_reason")
  completedBy     String?   @map("completed_by")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  sourceKey       String?   @map("source_key")
  version         Int       @default(1)
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  firm PlatformFirm @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([firmId, sourceKey])
  @@index([firmId, assigneeStaffId, status, dueAt])
  @@index([firmId, hostType, hostId])
  @@map("plat_task")
}
