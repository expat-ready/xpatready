// front-office-booking.prisma — consultation types, staff hours, time off, bookings, booking tokens. Owner: Lead B (front office).
// One file per area (DB-SPLIT, studio/DEVELOPING.md): a new module adds its own file here; never edit another area's file without its owner.
//
// FO-1b (P-558, P-559 (2); BACKLOG row FO-1b rows rev 3.1; contracts platform-and-front-office-contracts-2026-11-14.md
// §2.2 and §7 binding; requirements AG-04: AG-4-1, -4, -9, -26, -36, -62, BR-3). Schema only: the booking API is FO-3.
// Like the platform rows, these carry no workspace_id (the firm is the tenant; the demo reset leaves them) and every
// table carries firm_id first in every index but its primary key. A row naming a staff member, a type or a booking keys
// on (firm_id, <id>), so it can never point at another firm's row: composite foreign keys, RESTRICT on delete and update,
// to platform_staff (firm_id, id) and to this file's own tables; fo_consultation_type to platform_firm (Lead B's OK on
// #1741 for the four back-relation lines on platform.prisma). A type's hosts are a list, which no foreign key covers:
// a trigger checks each host is staff of the firm when the list is written. Rules Prisma cannot say are in the migration
// 20261114120000_fo1b_booking_tables: the no-overlap rule per host (btree_gist exclusion over SCHEDULED and RESCHEDULED
// bookings on the range padded by the type's gaps, BR-3, AG-4-26), the padded range and `sequence` kept by the database,
// status moves, token expiry and voiding (AG-4-36), checks on minutes, slugs, zones and hashes.
// person_id and prospect_id name FO-1a's fo_person and fo_prospect; their foreign keys come with whichever of FO-1a and
// FO-1b merges second (or FO-3), since neither table is on main yet. Every value seeded here is Sample.

/// What a consultation type is for (AG-4-10). FREE_CONSULT and OTHER may be public; FOLLOW_UP and CASE_REVIEW never are
/// (rule 3). FO-3a: PAID_CONSULT waits on map row 44 (payment at booking). The public page lists FREE_CONSULT and OTHER.
enum FoConsultationPurpose {
  FREE_CONSULT
  FOLLOW_UP
  CASE_REVIEW
  OTHER
}

/// FO-3a (AG-4-9 rule 1): a type's colour from the closed palette of eight. Sample values: the team's palette
/// (appointment-type-types.ts:101-110) is not in a capture readable here.
enum FoTypeColour {
  C1
  C2
  C3
  C4
  C5
  C6
  C7
  C8
}

/// How a consultation is held (AG-4-11).
enum FoMeetingMode {
  VIDEO
  PHONE
  IN_PERSON
}

/// A booking's status (requirements trace §A "Booking", AG-04 C2). Active, for the no-overlap rule: SCHEDULED and
/// RESCHEDULED (PENDING_PAYMENT joins them when paid types come). A booking is written SCHEDULED; CANCELLED is final;
/// COMPLETED and NO_SHOW are the attendance answer, recorded once the meeting has started and changeable later (AG-4-39).
enum FoBookingStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// A consultation type (AG-4-9, AG-4-4/-5/-66, AG-4-1 rule 2): its slug is unique in the firm and is the only way the
/// public page names it (AG-4-16). Timings empty = the firm's (AG-4-66 defaults: gap before 0 and after 10 minutes,
/// shortest notice 4 h, window 60 days, self-service limit 4 h; FO-3a1e); slot interval empty = the meeting's length. Hosts are staff of
/// the same firm (a trigger checks each id). Switching a type off keeps its bookings (AG-4-9 rule 4).
model FoConsultationType {
  id                      String                @id @default(uuid()) @db.Uuid
  firmId                  String                @map("firm_id") @db.Uuid
  slug                    String
  name                    String
  purpose                 FoConsultationPurpose @default(FREE_CONSULT)
  modes                   FoMeetingMode[]
  hostStaffIds            String[]              @map("host_staff_ids") @db.Uuid
  minutes                 Int
  /// FO-3a1e (AG-4-4 rule 2, §7): empty = the firm's Timings value, else the default (settings/timings.ts resolveTimings;
  /// the database's fo_booking_write pads by the same rule, 20261121110000_fo3a1e_firm_timings).
  gapBeforeMinutes        Int?                  @map("gap_before_minutes")
  gapAfterMinutes         Int?                  @map("gap_after_minutes")
  minNoticeMinutes        Int?                  @map("min_notice_minutes")
  windowDays              Int?                  @map("window_days")
  selfServiceLimitMinutes Int?                  @map("self_service_limit_minutes")
  slotIntervalMinutes     Int?                  @map("slot_interval_minutes")
  meetingLink             String?               @map("meeting_link")
  active                  Boolean               @default(true)
  /// FO-3pa (AG-4-16 rule 1, AG-4-9; concept fo-3-booking BR-1, BR-8): listed on the firm's booking page; a hidden type's
  /// page answers the one not-found. The booker may reschedule or cancel by the link only when allowed (AG-4-36..38 rule 4).
  showOnBookingPage       Boolean               @default(true) @map("show_on_booking_page")
  allowReschedule         Boolean               @default(true) @map("allow_reschedule")
  allowCancel             Boolean               @default(true) @map("allow_cancel")
  /// FO-3c part 2 (Lead 10, W4b; AG-4-15 rule 1): the consultation agreement must be signed before the consultation starts.
  /// Null = by purpose (on for all but FOLLOW_UP; consultation-agreement/gate.ts needsAgreement); a save stores the choice.
  requireAgreement        Boolean?              @map("require_agreement")
  /// FO-3a (AG-4-9 rules 1, 5, 7, §7): at most 1,000 characters; the optimistic-save counter; a soft delete (hidden
  /// everywhere, its bookings kept and still changeable, its slug freed: the slug is unique among not-deleted rows, a
  /// partial index in 20261116090000_fo3a_booking_types; "manage" is reserved); who created it (history only, no key).
  description             String?
  colour                  FoTypeColour          @default(C1)
  version                 Int                   @default(1)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz
  createdByStaffId        String?               @map("created_by_staff_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  firm      PlatformFirm    @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings  FoBooking[]
  hostSets  FoTypeHostSet[]

  /// Among not-deleted rows only (the migration's partial index; Prisma reads it as this unique).
  @@unique([firmId, slug])
  /// The target of fo_booking's (firm_id, type_id) key.
  @@unique([firmId, id])
  @@map("fo_consultation_type")
}

/// FO-3a part 1b (AG-4-62 rules 1, 1b, 1c, 4, §7): a named set of a person's hours with its own IANA zone; exactly one
/// default per person (partial unique index); a deleted set takes its windows and the types' choices of it.
model FoAvailabilitySet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  timeZone  String   @map("time_zone")
  /// The optimistic-save counter (a stale PATCH → 409).
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  staff    PlatformStaff    @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  windows  FoAvailability[]
  hostSets FoTypeHostSet[]

  @@unique([firmId, id])
  /// The target of the windows' and the types' (firm_id, staff_id, set_id) keys: a set is always the same person's.
  @@unique([firmId, staffId, id])
  /// Part 1c: a person's set names differ, ignoring case and repeated spaces: the unique index
  /// fo_availability_set_firm_id_staff_id_name_norm_key on (firm_id, staff_id, lower(…name…)) is in the migration only
  /// (an expression index has no Prisma form).
  /// Partial: WHERE is_default (at most one default per person).
  @@unique([firmId, staffId, isDefault], map: "fo_availability_set_one_default")
  @@map("fo_availability_set")
}

/// One weekly window of a set of hours (AG-4-62 rules 2-4): weekday 0 = Sunday … 6, minutes since local midnight in the
/// set's zone (kept on each window), start before end, no overlap within a set. Written without a set, it goes to the
/// person's default set, made when missing (fo_booking_set_default); business hours never limit slots (AG04-D22).
model FoAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  /// Set by the database when not given (the person's default set).
  setId       String   @default(dbgenerated()) @map("set_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  timeZone    String   @map("time_zone")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  staff PlatformStaff     @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  set   FoAvailabilitySet @relation(fields: [firmId, staffId, setId], references: [firmId, staffId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([firmId, staffId, weekday])
  @@index([firmId, setId])
  @@map("fo_availability")
}

/// FO-3a part 1b (AG-4-62 rule 1b): the set of hours a booking type uses for one of its hosts. No row = the host's
/// default set; a deleted set takes its rows with it, so the type falls back to the default.
model FoTypeHostSet {
  firmId    String   @map("firm_id") @db.Uuid
  typeId    String   @map("type_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  setId     String   @map("set_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  type FoConsultationType @relation(fields: [firmId, typeId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  set  FoAvailabilitySet  @relation(fields: [firmId, staffId, setId], references: [firmId, staffId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([firmId, typeId, staffId])
  @@map("fo_type_host_set")
}

/// A staff member's out-of-office period, whole or part days (AG-4-62 rules 5, 8): it removes every slot it overlaps and
/// never moves or cancels a booking (rule 7). created_by is who entered it (the person, or an Owner or Admin).
model FoTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  staff PlatformStaff @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([firmId, staffId, startsAt])
  @@map("fo_time_off")
}

/// A booking (contracts §2.2 as changed by §7; AG-4-25/-26, AG-4-36, AG-4-47): one host (staff_id), times in UTC
/// (timestamptz), the visitor's IANA zone for every message and invite (AG-4-18 rule 3). The database keeps block_range
/// (start − the type's gap before, end + its gap after; written by a trigger, never by the app) and `sequence` (0 when
/// written, +1 on each change to time, host, type, mode or status: the invite's SEQUENCE, AG-4-32). Two active bookings
/// of one host never overlap on block_range (BR-3). The host is one of the type's hosts and the mode one of its modes
/// when written; times are finite and at most a day apart; only an active booking changes time, host, type or mode.
model FoBooking {
  id              String                    @id @default(uuid()) @db.Uuid
  firmId          String                    @map("firm_id") @db.Uuid
  typeId          String                    @map("type_id") @db.Uuid
  staffId         String                    @map("staff_id") @db.Uuid
  personId        String?                   @map("person_id") @db.Uuid
  prospectId      String?                   @map("prospect_id") @db.Uuid
  status          FoBookingStatus           @default(SCHEDULED)
  sequence        Int                       @default(0)
  mode            FoMeetingMode
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz
  bookerTimeZone  String                    @map("visitor_time_zone")
  /// FO-3pa (AG-04 v2.1 Booking.cancelReason; AG-4-38 rule 8; Lead B rev 16.30): the booker's optional reason, written
  /// only by a cancel by link, in its transaction; at most 500 characters; NULL unless CANCELLED. Never in the audit.
  cancelReason    String?                   @map("cancel_reason")
  blockRange      Unsupported("tstzrange")? @map("block_range")
  /// FO-3sa (AG-4-63 rule 4): the staff member who chose "Book anyway" over an overlap; the no-overlap rule skips the row.
  overlapConfirmedByUserId String?        @map("overlap_confirmed_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  staff  PlatformStaff      @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  type   FoConsultationType @relation(fields: [firmId, typeId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  tokens FoBookingToken[]
  consultRecord FoConsultRecord?

  /// The target of fo_booking_token's (firm_id, booking_id) key.
  @@unique([firmId, id])
  @@index([firmId, staffId, startsAt])
  @@index([firmId, startsAt])
  @@index([firmId, typeId])
  @@index([firmId, personId])
  @@index([firmId, prospectId])
  @@map("fo_booking")
}

/// A self-service link's token (AG-4-36): only its SHA-256 hash (64 lower-case hex) is stored; several may be live for
/// one booking (one per email). It expires when the meeting ends (expires_at = the booking's ends_at, checked) and is
/// voided by the database when the booking leaves the active set or its time changes; only voided_at may change, once,
/// to the database's clock; a token is never deleted. Writing one touches its booking's row, so it is ordered with a
/// cancel at any isolation level.
/// FO-3 looks a token up by its id (selector) and compares the hash in constant time (verifier), so no index outside
/// the firm is needed.
model FoBookingToken {
  id        String    @id @default(uuid()) @db.Uuid
  firmId    String    @map("firm_id") @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  voidedAt  DateTime? @map("voided_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  booking FoBooking @relation(fields: [firmId, bookingId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([firmId, tokenHash])
  @@index([firmId, bookingId])
  @@map("fo_booking_token")
}
