// platform-register.prisma — complaints (later data requests, legal holds, breaches). Owner: Lead B (platform, contracts §9).
//
// PF-21 (P-579, P-584 (8), P-600; BACKLOG row PF-21, moved from FO-13k rev 12; contracts §0, §7, §9). The firm's complaints
// record: a complaint made to the firm by a client, a prospect or any other person, each handling step, the outcome and
// the dates (Code of Professional Conduct for College Licensees, SOR/2022-128, s. 29 "must promptly respond to any
// complaints made to the licensee by a client", s. 24(3)(r), s. 37; legal reading Unconfirmed: no counsel). The College's
// by-laws and complaint guidance are not yet read (its site is outside the cloud lane's network, 14 Nov), so every field,
// list and period here is Sample until they are. Platform rows carry no workspace_id: the demo reset leaves them.
// Rules Prisma cannot say (insert-only events, no delete for anyone, a closed complaint never changes, fixed facts, the
// complainant's shape) are plat_ triggers and checks in the migration 20261114234500_pf21_complaints. The complainant is
// named by kind + id, never a foreign key into another module (front office or case side): the id is the other module's.
// No audit table: every change writes the one trail through AuditPort (contracts §7).

/// Who made the complaint (P-584 (8)): a front-office person (a lead, prospect or client of the firm), a party on a case,
/// or another person, who has no record here and is named on the complaint itself.
enum PlatComplaintSubjectKind {
  FRONT_OFFICE_PERSON
  CASE_PARTY
  OTHER_PERSON
}

/// How the complaint reached the firm (Sample list until the by-laws are read).
enum PlatComplaintChannel {
  EMAIL
  PHONE
  IN_PERSON
  LETTER
  WEB_FORM
  OTHER
}

/// What the complaint is about (Sample list until the by-laws are read).
enum PlatComplaintCategory {
  SERVICE
  FEES
  COMMUNICATION
  CONDUCT
  PRIVACY
  OTHER
}

enum PlatComplaintStatus {
  OPEN
  CLOSED
}

/// The outcome, set once at closing (FO-13 rev 12's list).
enum PlatComplaintOutcome {
  RESOLVED
  UPHELD
  NOT_UPHELD
  WITHDRAWN
  REFERRED_TO_COLLEGE
}

/// One handling step. RECEIVED is the first event of every complaint; CLOSED the last that changes it; NOTE may follow a
/// close (a closed complaint changes only by a new event); REMINDER_SENT is the system's acknowledgement reminder.
enum PlatComplaintEventKind {
  RECEIVED
  ACKNOWLEDGED
  STEP
  NOTE
  RESPONSE_SENT
  HANDLER_CHANGED
  REMINDER_SENT
  CLOSED
}

/// A complaint made to the firm. Kept for the keep period (map row 105), never deleted by anyone (trigger). While OPEN only
/// the handler, the acknowledgement, the response date and the close change (each once, by trigger); once CLOSED nothing
/// changes. acknowledge_by is received_at + the Sample period (2 business days in the firm's zone), set by the service.
model PlatComplaint {
  id                 String                   @id @default(uuid()) @db.Uuid
  firmId             String                   @map("firm_id") @db.Uuid
  subjectKind        PlatComplaintSubjectKind @map("subject_kind")
  /// The other module's id of the person (front office or case side); empty for OTHER_PERSON.
  subjectId          String?                  @map("subject_id") @db.Uuid
  /// Needed for OTHER_PERSON (no record elsewhere); optional otherwise.
  complainantName    String?                  @map("complainant_name")
  complainantContact String?                  @map("complainant_contact")
  receivedAt         DateTime                 @map("received_at") @db.Timestamptz
  channel            PlatComplaintChannel
  category           PlatComplaintCategory
  summary            String
  handlerStaffId     String                   @map("handler_staff_id") @db.Uuid
  acknowledgeBy      DateTime                 @map("acknowledge_by") @db.Timestamptz
  acknowledgedAt     DateTime?                @map("acknowledged_at") @db.Timestamptz
  responseSentAt     DateTime?                @map("response_sent_at") @db.Timestamptz
  status             PlatComplaintStatus      @default(OPEN)
  outcome            PlatComplaintOutcome?
  closedAt           DateTime?                @map("closed_at") @db.Timestamptz
  recordedBy         String                   @map("recorded_by")
  /// PF-21i: the Idempotency-Key the complaint was recorded with (1-255 visible ASCII), unique per firm by a partial
  /// unique index in SQL (WHERE request_key IS NOT NULL; migration 20261118233000_pf21i_complaint_request_key); empty
  /// for complaints recorded before PF-21i. Set once, never changed (trigger).
  requestKey         String?                  @map("request_key")
  /// PF-21i: SHA-256 (hex) of the canonical request body (keys sorted): the same key with another body is refused.
  requestHash        String?                  @map("request_hash")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  firm    PlatformFirm         @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  handler PlatformStaff        @relation(fields: [firmId, handlerStaffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  events  PlatComplaintEvent[]

  @@unique([firmId, id])
  @@index([firmId, status, acknowledgeBy])
  @@index([firmId, handlerStaffId])
  @@index([firmId, subjectKind, subjectId])
  @@map("plat_complaint")
}

/// One handling step of a complaint: insert-only (a trigger refuses update, delete and truncate). seq orders the steps.
/// detail carries ids only; note is the handler's own words.
model PlatComplaintEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  seq         BigInt                 @default(autoincrement())
  firmId      String                 @map("firm_id") @db.Uuid
  complaintId String                 @map("complaint_id") @db.Uuid
  kind        PlatComplaintEventKind
  at          DateTime               @db.Timestamptz
  actor       String
  note        String?
  detail      Json?
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz

  complaint PlatComplaint @relation(fields: [firmId, complaintId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([firmId, complaintId, seq])
  @@map("plat_complaint_event")
}

// PF-21b part 2 (map row 85; SA-11 §3.5, SA-11-40, SA2-D25, BR-7, BR-12; brief design/briefs/track-b/PF-21b-2.md): legal
// holds, placed and released by ExpatReady's Platform Owner only (system/compliance:legal-hold). LegalHoldPort's real
// adapter (api/src/platform/register/holds/adapter.ts) reads this table; every deleter asks it first. Our own register:
// row-level security forced with no policy (PF-12's OWN list), so only the bypass role reads or writes it, and a firm's
// deleter reads its own firm's active holds through the definer plat_legal_hold_active(firm) only. Rules Prisma cannot
// say are in the migration 20261122180000_pf21b_legal_holds: the scope's shape, the firm must exist (a check, not a
// relation: PlatformFirm's file is not this row's), the times are the database's, never deleted, released once.
// Legal reading Unconfirmed: no counsel.

/// What a hold covers (§3.5: a firm, a case, a data category, a date range; SA-11-40: one person record).
enum PlatLegalHoldScope {
  FIRM
  CASE
  PERSON
  CATEGORY
  DATE_RANGE
}

/// One legal hold. A release sets the four release fields once (never a delete); a released hold matches nothing.
model PlatLegalHold {
  id            String             @id @default(uuid()) @db.Uuid
  firmId        String             @map("firm_id") @db.Uuid
  scopeKind     PlatLegalHoldScope @map("scope_kind")
  /// The case or person id (CASE, PERSON); another module's id, never a foreign key.
  targetId      String?            @map("target_id") @db.Uuid
  /// A LEGAL_HOLD_CATEGORY name (CATEGORY).
  category      String?
  rangeFrom     DateTime?          @map("range_from") @db.Timestamptz
  rangeTo       DateTime?          @map("range_to") @db.Timestamptz
  reason        String
  placedBy      String             @map("placed_by")
  /// The database's time at placement (trigger).
  placedAt      DateTime           @default(now()) @map("placed_at") @db.Timestamptz
  releasedBy    String?            @map("released_by")
  releasedAt    DateTime?          @map("released_at") @db.Timestamptz
  releaseReason String?            @map("release_reason")

  @@index([firmId, releasedAt])
  @@map("plat_legal_hold")
}

// PF-21b part 3 (map row 85; SA-11 §3.8, SA-11-40, NFR5-14): the register of privacy requests made to ExpatReady itself,
// worked in our console with system/compliance:dsr-manage. Our own register, forced with no policy (PF-12's OWN list),
// reached only through the plat_data_request_* definers of 20261123100000_pf21b_data_requests, which also holds the rules
// Prisma cannot say. The target date (received + 30 days) is a code constant and a reminder (Unconfirmed: no counsel).

/// Access, correction or deletion (§3.8).
enum PlatDataRequestType {
  ACCESS
  CORRECTION
  DELETION
}

/// §3.8's statuses. OVERDUE is set only by the daily check (past its target, still open); COMPLETED is final.
enum PlatDataRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  HELD
}

/// One step of a request. RECEIVED is the first; STATUS_CHANGED a move; NOTE a staff note; NEAR_DATE_ALERTED and
/// OVERDUE_ALERTED the daily check's marks (at most one of each per request: the alert is raised once).
enum PlatDataRequestEventKind {
  RECEIVED
  STATUS_CHANGED
  NOTE
  NEAR_DATE_ALERTED
  OVERDUE_ALERTED
  /// PF-21d part 1b: approved (note "Erasing on <date>"), cancelled, blocked by a legal hold, one module's result, skipped
  /// (the "Data erasure" switch off). Written by the erasure definers only.
  ERASURE_APPROVED
  ERASURE_CANCELLED
  ERASURE_HELD
  ERASURE_RESULT
  ERASURE_SKIPPED
}

/// A request made to ExpatReady. Never deleted (trigger). The requester is a name and a contact only (no other personal
/// data); firm_id and person_id name the person record a request is about (SA-11-40), both or neither, another module's
/// ids, never a foreign key. completed_on is §3.8's response date.
model PlatDataRequest {
  id             String                @id @default(uuid()) @db.Uuid
  type           PlatDataRequestType
  requesterName  String                @map("requester_name")
  requesterEmail String                @map("requester_email")
  receivedOn     DateTime              @map("received_on") @db.Date
  targetDate     DateTime              @map("target_date") @db.Date
  status         PlatDataRequestStatus @default(PENDING)
  actionsTaken   String?               @map("actions_taken")
  completedOn    DateTime?             @map("completed_on") @db.Date
  firmId         String?               @map("firm_id") @db.Uuid
  personId       String?               @map("person_id") @db.Uuid
  recordedBy     String                @map("recorded_by")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  /// PF-21d part 1b: the day an approved DELETION is carried out (approval day + 7); cleared by cancel or by the job.
  eraseOn        DateTime?             @map("erase_on") @db.Date

  events PlatDataRequestEvent[]

  @@index([status, targetDate])
  @@map("plat_data_request")
}

/// One step of a request: insert-only (a trigger refuses update, delete and truncate); seq orders the steps.
model PlatDataRequestEvent {
  id         String                   @id @default(uuid()) @db.Uuid
  seq        BigInt                   @default(autoincrement())
  requestId  String                   @map("request_id") @db.Uuid
  kind       PlatDataRequestEventKind
  fromStatus PlatDataRequestStatus?   @map("from_status")
  toStatus   PlatDataRequestStatus?   @map("to_status")
  note       String?
  actor      String
  at         DateTime                 @default(now()) @db.Timestamptz

  request PlatDataRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, seq])
  @@map("plat_data_request_event")
}

/// PF-21d part 1a (SA-11-16 (d)): a platform switch, on by default (SA-12's flags are not built). Our own table: forced,
/// no policy; changed only through plat_switch_set with a reason, by our staff. Never deleted.
model PlatSwitch {
  key       String    @id
  isOn      Boolean   @default(true) @map("is_on")
  changedBy String?   @map("changed_by")
  changedAt DateTime? @map("changed_at") @db.Timestamptz

  events PlatSwitchEvent[]

  @@map("plat_switch")
}

/// One change of a switch, with its reason: insert-only.
model PlatSwitchEvent {
  id     String   @id @default(uuid()) @db.Uuid
  seq    BigInt   @default(autoincrement())
  key    String
  isOn   Boolean  @map("is_on")
  reason String
  actor  String
  at     DateTime @default(now()) @db.Timestamptz

  switch PlatSwitch @relation(fields: [key], references: [key], onDelete: Restrict, onUpdate: Restrict)

  @@unique([key, seq])
  @@map("plat_switch_event")
}
