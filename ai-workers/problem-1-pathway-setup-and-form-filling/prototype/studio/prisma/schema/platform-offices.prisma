// platform-offices.prisma — a firm's offices, each with its own time zone, business hours and closed days, and which office
// a staff member works in (PF-18a part 1; AG-1-74, AG-16-68, AG-16-59). Owner: Lead B (platform). Its own file (P-600):
// platform_firm and platform_staff get only their back-relation lines, under the slot `offices (PF-18a)` in platform.prisma
// (Lead B on #2009, rows rev 16.6). Real keys on (firm, …); the rules Prisma cannot say are in 20261116190000_pf18a_offices. Read and written only
// through api/src/platform/settings/offices/; other modules read the clock through OfficeClockPort (ports/offices.ts).
// PF-18a part 2 adds platform_notification_preference to this file.

/// One office of a firm (AG-16-68, AG-1-74). A firm with no row has one implicit office: its own settings
/// (platform.time_zone, platform.business_hours, platform.closed_days). Rows exist only once a second office is added;
/// that add also writes the first office (`is_first`), holding the firm's zone, hours and closed days at that moment
/// (AG-1-74 §7, AG16-55 Q14). Hours and closed days are JSON checked by the same zod schemas as the firm settings.
model PlatformOffice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId        String   @map("firm_id") @db.Uuid
  name          String
  /// The address's province or territory (Canada Post code) when the office is in Canada; null when unknown.
  province      String?
  /// ISO 3166-1 alpha-2 of the office address ("CA" unless the office is abroad).
  countryCode   String   @default("CA") @map("country_code") @db.Char(2)
  /// An IANA zone name (AG-1-74 §7), pre-filled from the province (samples/province-time-zones-ca.json), editable.
  timeZone      String   @map("time_zone")
  businessHours Json     @map("business_hours")
  closedDays    Json     @map("closed_days")
  isFirst       Boolean  @default(false) @map("is_first")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  firm  PlatformFirm          @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staff PlatformStaffOffice[]
  @@unique([firmId, id])
  @@unique([firmId, name])
  @@map("platform_office")
}

/// Which office a staff member works in (optional: no row, no office, so the firm's own zone applies). One per person.
model PlatformStaffOffice {
  staffId   String   @id @map("staff_id") @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  setBy     String   @map("set_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  office PlatformOffice @relation(fields: [firmId, officeId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  staff  PlatformStaff  @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([firmId, staffId])
  @@index([firmId, officeId])
  @@map("platform_staff_office")
}
